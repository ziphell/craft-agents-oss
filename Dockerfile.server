# =============================================================================
# Craft Agents Server — multi-platform Docker image
#
# Build:
#   docker buildx build -f Dockerfile.server -t craft-agent-server .
#
# Run (use --user to match host UID/GID for volume permissions):
#   docker run --rm -p 9100:9100 \
#     --user $(id -u):$(id -g) \
#     -e HOME=/home/craftagents \
#     -e CRAFT_SERVER_TOKEN=<secret> \
#     craft-agent-server
#
# Run with TLS + mounted config:
#   docker run --rm -p 9100:9100 \
#     --user $(id -u):$(id -g) \
#     -e HOME=/home/craftagents \
#     -e CRAFT_SERVER_TOKEN=<secret> \
#     -e CRAFT_RPC_TLS_CERT=/certs/cert.pem \
#     -e CRAFT_RPC_TLS_KEY=/certs/key.pem \
#     -v /path/to/certs:/certs:ro \
#     -v ~/.craft-agent:/home/craftagents/.craft-agent \
#     craft-agent-server
# =============================================================================

FROM oven/bun:1.3.14-slim

LABEL org.opencontainers.image.source="https://github.com/lukilabs/craft-agents-oss"
LABEL org.opencontainers.image.description="Craft Agents Server — headless AI workflow server"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# Install system deps + Node.js (required by the WhatsApp worker subprocess;
# Bun cannot run Baileys' crypto deps). The major is pinned to match the Node
# bundled into the standalone server package (vendor/node) so both runtimes
# stay on the same line.
ARG NODE_MAJOR=22
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates git ripgrep curl gnupg && \
    curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# The printing host
#
# `convert --to pdf` and `render` are the two conversions the GenOffice engine
# cannot do on its own: it spawns "the app" as `<app> --headless-export …` and
# waits for a file. On a desktop that app is Electron; on a hub there is none, so
# `packages/render-host` answers the same contract with a headless Chromium.
#
# Two things here are load-bearing and neither is optional:
#
# - **The fonts.** A PDF without `fonts-noto-cjk` does not fail — it silently
#   paginates a substituted face, so Chinese text reflows and nobody finds out
#   until a person opens the file. `fontconfig` is what makes them visible.
# - **The Chromium's own runtime libraries.** Playwright downloads a browser, not
#   the shared objects it needs; without libnss3/libgbm1/libasound2 the launcher
#   exits with "failed to start" and every export becomes a timeout.
#
# The browser is Playwright's pinned `chromium-headless-shell` rather than the
# distribution's `chromium`: the driver and the browser speak one CDP dialect
# when their versions match, and the headless shell is ~250 MB instead of ~500.
# -----------------------------------------------------------------------------
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      fontconfig \
      fonts-noto-cjk \
      fonts-dejavu-core \
      libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
      libgbm1 libasound2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
      libxrandr2 libpango-1.0-0 libcairo2 libx11-6 libxcb1 libxext6 \
    && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Create non-root user (Claude Code SDK refuses to run as root).
# At runtime, override with --user $(id -u):$(id -g) to match host permissions.
RUN groupadd -r craftagents && \
    useradd -r -g craftagents -m -d /home/craftagents -s /bin/bash craftagents

WORKDIR /app

# Copy dependency manifests first for layer caching.
# `bunfig.toml` MUST be in the WORKDIR before `bun install` runs — it sets
# `linker = "hoisted"`, which is required for the WebUI / renderer build
# (transitive deps like i18next, @tiptap/*, pdfjs-dist resolve at top-level
# node_modules). Without it Bun defaults to isolated installs and the Vite
# build fails on the first transitive bare-package import.
COPY package.json bun.lock bunfig.toml ./
COPY packages/server/package.json packages/server/
COPY packages/server-core/package.json packages/server-core/
COPY packages/shared/package.json packages/shared/
COPY packages/core/package.json packages/core/
COPY packages/session-tools-core/package.json packages/session-tools-core/
COPY packages/pi-agent-server/package.json packages/pi-agent-server/
COPY packages/craft-agents-commands/package.json packages/craft-agents-commands/
COPY packages/craft-cli/package.json packages/craft-cli/
COPY packages/ui/package.json packages/ui/
COPY packages/messaging-gateway/package.json packages/messaging-gateway/
COPY packages/messaging-whatsapp-worker/package.json packages/messaging-whatsapp-worker/
COPY packages/render-host/package.json packages/render-host/
COPY packages/office-host/package.json packages/office-host/
COPY apps/electron/package.json apps/electron/
COPY apps/cli/package.json apps/cli/
COPY apps/marketing/package.json apps/marketing/
COPY apps/viewer/package.json apps/viewer/
COPY apps/webui/package.json apps/webui/
COPY apps/docs-site/package.json apps/docs-site/

RUN bun install --frozen-lockfile

# Copy source
COPY . .

# The Bun-bundled command-line tools (img/asr/ical) are built from
# apps/electron/resources/cli-tools/*.ts, and their OCR / VAD models are fetched
# rather than committed. `build:cli-tools` stages the models beside the bundles.
RUN bun run fetch:ocr-models && \
    bun run fetch:sherpa-vad && \
    bun run build:cli-tools

# Stage the bundled assets the runtime reads on launch (docs → ~/.craft-agent/docs,
# plus themes, permissions, tool-icons, release-notes, config-defaults.json,
# command-line tools and speech models) into the distribution's own resources/ —
# the same layout scripts/build-server.ts produces.
# Without this the assets root would have to point at apps/electron/resources, which
# is an Electron packaging detail the server does not otherwise depend on.
#
# The editors and the xlsx sidecar are fetched/compiled on the packaging host and
# gitignored, so they are checked below: a clean checkout must fail the build rather
# than ship an image whose documents, diagrams or printing are silently missing.
RUN for path in \
      apps/electron/resources/drawio \
      apps/electron/resources/office \
      apps/electron/resources/office-engine \
      apps/electron/resources/cli \
      apps/electron/resources/office-native/xlsx-sidecar; do \
      test -e "/app/$path" || { \
        echo "Missing $path — build it on the packaging host first (docs/build-server-linux.md §5)"; \
        exit 1; \
      }; \
    done
RUN mkdir -p /app/resources && \
    cp -R /app/apps/electron/resources/docs \
          /app/apps/electron/resources/themes \
          /app/apps/electron/resources/permissions \
          /app/apps/electron/resources/tool-icons \
          /app/apps/electron/resources/release-notes \
          /app/apps/electron/resources/cli-tools \
          /app/apps/electron/resources/models \
          /app/resources/ && \
    cp /app/apps/electron/resources/config-defaults.json /app/resources/ && \
    cp -R /app/apps/electron/resources/drawio /app/resources/ && \
    cp -R /app/apps/electron/resources/office /app/resources/ && \
    cp -R /app/apps/electron/resources/office-engine /app/resources/ && \
    cp -R /app/apps/electron/resources/cli /app/resources/ && \
    mkdir -p /app/resources/office-native && \
    cp /app/apps/electron/resources/office-native/xlsx-sidecar /app/resources/office-native/

# The hub's own printing host: the bundle the engine spawns, and the browser it drives.
RUN node node_modules/playwright-core/cli.js install chromium-headless-shell && \
    bun run --cwd packages/render-host build:cli && \
    mkdir -p /app/resources/render-host && \
    cp /app/packages/render-host/dist/cli.mjs /app/resources/render-host/ && \
    cp /app/packages/render-host/dist/craft-headless-export /app/resources/render-host/ && \
    chmod +x /app/resources/render-host/craft-headless-export

# Build the Pi agent server (bundled CJS — required by runtime-resolver.ts)
RUN bun build packages/pi-agent-server/src/index.ts \
      --outfile packages/pi-agent-server/dist/index.js --target node --format cjs

# Build the WhatsApp worker bundle (CJS, Node target — Bun cannot run it).
RUN bun run scripts/build-wa-worker.ts

# Build web UI assets (served by the server on the RPC port).
# vite's bundler runs under Node (via shebang in vite's bin) and hits V8's
# default ~2GB heap cap on the rendering phase (>5k modules). Raise to 4GB
# so low-RAM build hosts (e.g. 4GB VPS) can complete the build.
RUN NODE_OPTIONS="--max-old-space-size=4096" bunx vite build --config apps/webui/vite.config.ts

# Pre-create .craft-agent so Docker named volumes inherit the correct permissions.
RUN mkdir -p /home/craftagents/.craft-agent

# Make app world-readable so any --user can run it. Home dir is writable for .craft-agent.
# Use find to only touch files/dirs missing the read bit — much faster than chmod -R on the
# entire tree (node_modules alone has hundreds of thousands of entries).
RUN find /app -not -perm -o=r -exec chmod o+r {} + && \
    find /app -type d -not -perm -o=x -exec chmod o+x {} + && \
    chmod -R 777 /home/craftagents

USER craftagents

ENV CRAFT_RPC_HOST=0.0.0.0
ENV CRAFT_RPC_PORT=9100
ENV CRAFT_WEBUI_DIR=/app/apps/webui/dist
# Runtime bundled assets are the image's own resources/ staged above, not
# apps/electron/resources — same layout as the tarball from scripts/build-server.ts.
ENV CRAFT_BUNDLED_ASSETS_ROOT=/app
ENV CRAFT_RESOURCES_PATH=/app/resources
# Command-line tools (img/asr/ical bundles) and their models, staged above.
ENV CRAFT_CLI_TOOLS=/app/resources/cli-tools/dist
# WhatsApp worker — Bun cannot run the CJS worker, so we point the adapter at
# system `node` (installed above). This now matches the path packages/server
# derives from CRAFT_BUNDLED_ASSETS_ROOT, and stays explicit so it is visible here.
ENV CRAFT_MESSAGING_WA_WORKER=/app/packages/messaging-whatsapp-worker/dist/worker.cjs
ENV CRAFT_MESSAGING_NODE_BIN=node

EXPOSE 9100

ENTRYPOINT ["bun", "run", "packages/server/src/index.ts"]
