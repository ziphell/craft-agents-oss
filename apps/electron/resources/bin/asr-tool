#!/bin/sh
# asr-tool — see apps/electron/resources/cli-tools/asr-tool.ts. Bun, so no Python and no uv on any host.
BUN="${CRAFT_BUN:-bun}"
DIR="${CRAFT_CLI_TOOLS:-$(dirname "$0")/../cli-tools/dist}"
if [ ! -f "$DIR/asr-tool.mjs" ]; then
  echo "asr-tool: not built (run: bun run build:cli-tools)" >&2
  exit 2
fi
exec "$BUN" run "$DIR/asr-tool.mjs" "$@"
