# Build artifacts for DMG packaging
vendor/
# ...but the editable-PPTX engine is checked in on purpose (MIT; see
# resources/vendor/dom-to-pptx/README.md) — the `vendor/` rule above would
# otherwise swallow it.
!resources/vendor/
packages/
release/
node_modules/@anthropic-ai/

# Platform-specific uv binaries (downloaded during build)
resources/bin/darwin-arm64/
resources/bin/darwin-x64/
resources/bin/win32-x64/
resources/bin/linux-x64/
